generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ───────────────────────────────────────────────

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String        @map("password_hash")
  name          String
  role          UserRole      @default(client)
  createdAt     DateTime      @default(now()) @map("created_at")
  projectUsers  ProjectUser[]
  chatSessions  ChatSession[]
  notifications Notification[]
  invitations   Invitation[]

  @@map("users")
}

enum UserRole {
  superadmin
  admin
  client
}

model Project {
  id               String            @id @default(cuid())
  name             String
  isActive         Boolean           @default(true) @map("is_active")
  // Вектор-мікросервіс (3 індекси: global спільний + static/dynamic на компанію)
  vectorProjectId  String?           @map("vector_project_id")
  vectorToken      String?           @map("vector_token")
  vectorSyncedAt   DateTime?         @map("vector_synced_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  projectUsers     ProjectUser[]
  socialNetworks   SocialNetwork[]
  categories       Category[]
  personas         Persona[]
  postGroups       PostGroup[]
  chatSessions     ChatSession[]
  notifications    Notification[]
  mediaItems       MediaItem[]
  scheduleSettings ScheduleSettings?
  invitations      Invitation[]
  knowledgeEntries KnowledgeEntry[]
  contentTypes     ContentType[]
  contentTopics    ContentTopic[]
  products         Product[]
  leadMagnets      LeadMagnet[]

  @@map("projects")
}

model ProjectUser {
  userId    String      @map("user_id")
  projectId String      @map("project_id")
  role      ProjectRole @default(viewer)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@map("project_users")
}

enum ProjectRole {
  owner
  editor
  viewer
}

model Invitation {
  id        String    @id @default(cuid())
  email     String
  projectId String    @map("project_id")
  token     String    @unique
  role      ProjectRole @default(editor)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdBy String    @map("created_by")
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator   User      @relation(fields: [createdBy], references: [id])
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("invitations")
}

// ─── Content ────────────────────────────────────────────

model SocialNetwork {
  id         String      @id @default(cuid())
  projectId  String      @map("project_id")
  name       String
  platformKey String     @map("platform_key") // instagram_posts, threads, linkedin...
  icon       String?
  color      String?     // hex
  isEnabled  Boolean     @default(true) @map("is_enabled")
  sortOrder  Int         @default(0) @map("sort_order")
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  categories Category[]
  postGroups PostGroup[]

  @@map("social_networks")
}

model Category {
  id              String        @id @default(cuid())
  projectId       String        @map("project_id")
  socialNetworkId String        @map("social_network_id")
  name            String
  color           String?
  description     String?
  clientType      String?       @map("client_type") // TYPE_1, TYPE_2, TYPE_3
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  socialNetwork   SocialNetwork @relation(fields: [socialNetworkId], references: [id])
  postGroups      PostGroup[]

  @@map("categories")
}

model Persona {
  id             String      @id @default(cuid())
  projectId      String      @map("project_id")
  name           String
  age            Int?
  gender         String?
  type           String?     // TYPE_1, TYPE_2, TYPE_3
  pains          String?     @db.Text
  goals          String?     @db.Text
  tone           String?
  forbiddenWords String?     @map("forbidden_words") @db.Text
  triggers       String?     @db.Text // що штовхає до покупки
  objections     String?     @db.Text // заперечення/сумніви
  language       String?     @db.Text // як говорить (лексика, приклади фраз)
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  postGroups     PostGroup[]
  createdAt      DateTime    @default(now()) @map("created_at")

  @@map("personas")
}

model PostGroup {
  id              String        @id @default(cuid())
  number          Int           @unique @default(autoincrement())
  projectId       String        @map("project_id")
  socialNetworkId String        @map("social_network_id")
  categoryId      String?       @map("category_id")
  personaId       String?       @map("persona_id")
  postDate        DateTime      @map("post_date") @db.Date
  type            PostGroupType @default(single)
  audience        String?       // cold, warm1, warm2, hot1, hot2
  status          PostStatus    @default(draft)
  scheduleTime    String?       @map("schedule_time") // "09:00"
  // Ф3.1 (#305) strategic-атоми на рівні ЮНІТА (Варіант A); PostItem лишається render-шаром
  hookA           String?       @map("hook_a") @db.Text
  hookB           String?       @map("hook_b") @db.Text
  hookSelected    String?       @map("hook_selected")
  cta             String?       @db.Text
  structureId     String?       @map("structure_id")
  evidenceType    String?       @map("evidence_type") // case | example | story
  caseId          String?       @map("case_id")
  scores          Json          @default("{}")
  arcId           String?       @map("arc_id")
  experimentId    String?       @map("experiment_id")
  skeleton        Boolean       @default(false) // двофазна генерація: скелет без текстів
  intent          String?       // Ф3.6 educate | sell | trust | storytelling | entertainment
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  socialNetwork   SocialNetwork @relation(fields: [socialNetworkId], references: [id])
  category        Category?     @relation(fields: [categoryId], references: [id])
  persona         Persona?      @relation(fields: [personaId], references: [id])
  items           PostItem[]
  notifications   Notification[]
  publicationQueue PublicationQueue?

  @@index([projectId, postDate])
  @@map("post_groups")
}

enum PostGroupType {
  single
  carousel
  thread_chain
  stories
}

enum PostStatus {
  draft
  scheduled
  published
  archived
}

model PostItem {
  id               String            @id @default(cuid())
  groupId          String            @map("group_id")
  orderIndex       Int               @map("order_index") @default(0)
  content          String?           @db.Text
  imagePrompt      String?           @map("image_prompt") @db.Text
  imagePath        String?           @map("image_path")
  imageType        String?           @map("image_type") // flux, ideogram, recraft...
  funnelSlug       String?           @map("funnel_slug")
  funnelParams     Json?             @map("funnel_params")
  generationStatus GenerationStatus  @default(pending) @map("generation_status")
  generationError  String?           @map("generation_error") @db.Text
  isCta            Boolean           @default(false) @map("is_cta")
  slideTitle       String?           @map("slide_title")
  slideSubtitle    String?           @map("slide_subtitle")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  group            PostGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, orderIndex])
  @@map("post_items")
}

// Ф3.1/Ф1.5 Кейси — тільки записи з id (ніколи «памʼять моделі»)
model Case {
  id            String   @id @default(cuid())
  projectId     String   @map("project_id")
  title         String
  niche         String?
  problem       String?  @db.Text
  solution      String?  @db.Text
  metrics       Json     @default("{}") // цифри-результати
  allowedClaims String?  @map("allowed_claims") @db.Text // дозволені формулювання
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("cases")
}

// Ф1.3 Сторіз-арки (серія повʼязаних юнітів)
model StoryArc {
  id        String    @id @default(cuid())
  projectId String    @map("project_id")
  goal      String?
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  unitIds   Json      @default("[]") @map("unit_ids")
  status    String    @default("planned")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([projectId])
  @@map("story_arcs")
}

// Ф3.2 Експерименти + анти-цементування
model Experiment {
  id           String    @id @default(cuid())
  projectId    String    @map("project_id")
  hypothesis   String    @db.Text
  minPosts     Int       @default(5) @map("min_posts")
  metric       String?
  baseline     Float?
  status       String    @default("testing")
  confidence   Float?
  sampleSize   Int       @default(0) @map("sample_size")
  lastVerified DateTime? @map("last_verified")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([projectId, status])
  @@map("experiments")
}

model WinningPattern {
  id           String    @id @default(cuid())
  projectId    String    @map("project_id")
  kind         String // hook | structure | topic | pain
  platform     String?
  score        Float     @default(0)
  confidence   Float?
  sampleSize   Int       @default(0) @map("sample_size")
  lastVerified DateTime? @map("last_verified")
  status       String    @default("needs_retest") // confirmed | needs_retest
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([projectId, kind])
  @@map("winning_patterns")
}

// Ф1.8 Журнал правок (local/global)
model EditLog {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  scope     String   @default("local") // local | global
  category  String? // style | factual | cta | structure | visual
  unitId    String?  @map("unit_id")
  text      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@map("edit_logs")
}

// Відновлення пароля (#237-аналог для content2; згодом переїде в SSO #284)
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

// Ф3.6 SMM-стратегія: content pillars + intent-квоти (версійована)
model SmmStrategy {
  id                  String   @id @default(cuid())
  projectId           String   @map("project_id")
  contentPillars      Json     @default("[]") @map("content_pillars")
  intentDistribution  Json     @default("{}") @map("intent_distribution") // {educate:0.30, sell:0.20, ...}
  version             Int      @default(1)
  activeFrom          DateTime @default(now()) @map("active_from")
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@map("smm_strategies")
}

// Ф2.4 Ідемпотентність вебхуків генерації (unit_id, attempt)
model ProcessedWebhook {
  id        String   @id @default(cuid())
  unitId    String   @map("unit_id")
  attempt   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([unitId, attempt])
  @@map("processed_webhooks")
}

enum GenerationStatus {
  pending
  generating_text
  generating
  done
  failed
}

// ─── Media ──────────────────────────────────────────────

model MediaItem {
  id           String   @id @default(cuid())
  projectId    String   @map("project_id")
  fileName     String   @map("file_name")
  filePath     String   @map("file_path")
  mimeType     String   @map("mime_type")
  folder       String?
  tags         Json?
  aiGenerated  Boolean  @default(false) @map("ai_generated")
  createdAt    DateTime @default(now()) @map("created_at")
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("media_items")
}

// ─── Chat ───────────────────────────────────────────────

model ChatSession {
  id           String        @id @default(cuid())
  projectId    String        @map("project_id")
  userId       String        @map("user_id")
  sessionKey   String        @unique @map("session_key")
  lastActivity DateTime      @default(now()) @map("last_activity")
  createdAt    DateTime      @default(now()) @map("created_at")
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id])
  messages     ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String      @map("session_id")
  role      MessageRole
  content   String      @db.Text
  createdAt DateTime    @default(now()) @map("created_at")
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

enum MessageRole {
  user
  assistant
}

// ─── Notifications ──────────────────────────────────────

model Notification {
  id          String    @id @default(cuid())
  projectId   String    @map("project_id")
  userId      String    @map("user_id")
  type        String    // generation_done, generation_failed, scheduled_reminder
  title       String
  body        String    @db.Text
  postGroupId String?   @map("post_group_id")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])
  postGroup   PostGroup? @relation(fields: [postGroupId], references: [id])

  @@index([userId, readAt])
  @@map("notifications")
}

// ─── Schedule ───────────────────────────────────────────

model ScheduleSettings {
  id               String   @id @default(cuid())
  projectId        String   @unique @map("project_id")
  monday           Json     @default("[]")
  tuesday          Json     @default("[]")
  wednesday        Json     @default("[]")
  thursday         Json     @default("[]")
  friday           Json     @default("[]")
  saturday         Json     @default("[]")
  sunday           Json     @default("[]")
  sendToTelegram   Boolean  @default(true) @map("send_to_telegram")
  telegramChatId   String?  @map("telegram_chat_id")
  digestTime       String?  @map("digest_time")
  digestChatId     String?  @map("digest_chat_id")
  lastDigestDate   String?  @map("last_digest_date")
  updatedAt        DateTime @updatedAt @map("updated_at")
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("schedule_settings")
}

// ─── Knowledge Base ─────────────────────────────────────

model KnowledgeEntry {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  category  String   @default("general") // style, rule, forbidden, tone, audience, general
  title     String
  content   String   @db.Text
  addedBy   String   @default("user") @map("added_by") // user | bot
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, isActive])
  @@map("knowledge_entries")
}

// ─── Content Types ──────────────────────────────────────

model ContentType {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  name        String
  description String?  @db.Text
  prompt      String   @db.Text
  tone        String?
  structure   String?  @db.Text
  platforms   Json     @default("[]")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("content_types")
}

// Банк тем: рубрика (напрямок) → тема → пост. Editable per-project in /topics.
model ContentTopic {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  rubric      String   // напрямок: galuzi|nuances|cases|theoretical|heroes|tools|personal
  title       String   // конкретна тема
  notes       String?  @db.Text
  platforms   Json     @default("[]") // опційно: для яких мереж тема
  status      String   @default("idea") // idea | planned | used
  timesUsed   Int      @default(0) @map("times_used")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("content_topics")
}

// ─── Products & Lead Magnets ────────────────────────────
// Продукти, які продаємо через соцмережі. Контент-план орієнтується на них.
model Product {
  id          String       @id @default(cuid())
  projectId   String       @map("project_id")
  name        String
  description String?      @db.Text // що це, кому, ключова цінність — щоб контент вів до продажу
  price       String?      // вільний текст: "2500 грн", "від $500", "за запитом"
  audience    String?      @db.Text // для кого продукт (ЦА)
  pains       String?      @db.Text // болі, які закриває (ШІ пропонує за методологією)
  transformation String?   @db.Text // до/після — трансформація клієнта
  benefits    String?      @db.Text // ключові переваги
  priority    Int?         // пріоритет продукту (1 = головний)
  isActive    Boolean      @default(true) @map("is_active")
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  leadMagnets LeadMagnet[]

  @@index([projectId, isActive])
  @@map("products")
}

// Лід-магніти прив'язані до продукту (1 продукт → N магнітів).
// Кожен веде на воронку у flows; звідси контент-бот бере посилання й тему для постів.
model LeadMagnet {
  id             String   @id @default(cuid())
  projectId      String   @map("project_id")
  productId      String   @map("product_id")
  name           String
  description    String?  @db.Text // «про що писати» — суть магніту, обіцянка, кут
  funnelSlug     String?  @map("funnel_slug") // slug воронки у flows (bot-karta-sales тощо)
  botUsername    String?  @map("bot_username") // напр. den_fineko_bot → t.me/<bot>?start=...
  baseStartParam String?  @map("base_start_param") // базовий payload deep-link; дефолт = funnelSlug
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([projectId, isActive])
  @@index([productId])
  @@map("lead_magnets")
}

// ─── Publication (future) ───────────────────────────────

model PublicationQueue {
  id          String   @id @default(cuid())
  postGroupId String   @unique @map("post_group_id")
  platform    String
  scheduledAt DateTime @map("scheduled_at")
  status      String   @default("pending") // pending, published, failed
  externalId  String?  @map("external_id")
  errorMessage String? @map("error_message") @db.Text
  postGroup   PostGroup @relation(fields: [postGroupId], references: [id], onDelete: Cascade)

  @@map("publication_queue")
}


// ─── Content Tools (Global) ───────────────────────────────────

model ContentTool {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  aiDescription String    @map("ai_description") @db.Text
  exampleOutput String?   @map("example_output") @db.Text
  paramsSchema  Json      @default("[]") @map("params_schema")
  isActive      Boolean   @default(true) @map("is_active")
  sortOrder     Int       @default(0) @map("sort_order")
  syncedAt      DateTime? @map("synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("content_tools")
}
